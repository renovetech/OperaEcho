{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "backend",
        "start"
      ],
      "port": 3001
    },
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "frontend",
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "pwa",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "--yes",
        "serve@14.2.4",
        "opera-echo-mobile/dist",
        "-l",
        "5005",
        "-s"
      ],
      "port": 5005
    }
  ]
}
