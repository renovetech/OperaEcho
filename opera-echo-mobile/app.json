{
  "expo": {
    "name": "Opera Echo Mobile",
    "slug": "opera-echo-mobile",
    "version": "2026.12.01",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "operaechomobile",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "UIBackgroundModes": [
          "location",
          "fetch"
        ]
      }
    },
    "android": {
      "package": "com.operaecho.management",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundColor": "#E6F4FE"
      },
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "RECEIVE_BOOT_COMPLETED",
        "WAKE_LOCK",
        "VIBRATE",
        "SCHEDULE_EXACT_ALARM"
      ],
      "versionCode": 20261201
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": false
          }
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-secure-store",
        {
          "faceIDPermission": "Permita que o Opera Echo use o Face ID para proteger e liberar a sua entrada com biometria."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Permita que o Opera Echo use o Face ID para a entrada com biometria."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Permita que o Opera Echo grave sua localização em segundo plano para validar os locais das visitas e horas extras.",
          "locationWhenInUsePermission": "Permita que o Opera Echo acesse sua localização para validar os registros de check-in.",
          "isAndroidBackgroundLocationEnabled": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "740b6b29-2f73-4868-9d60-04e87ee07365"
      }
    }
  }
}
