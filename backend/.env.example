# ============================================================
# OPERA ECHO - VARIÁVEIS DE AMBIENTE
# Copie este arquivo para .env e preencha os valores reais
# ============================================================

# Banco de Dados SQL Server
DB_USER=
DB_PASSWORD=
DB_SERVER=
DB_DATABASE=
DB_PORT=

# JWT (Gere uma chave forte: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_SECRET=
JWT_EXPIRES_IN=

# Servidor
PORT=
NODE_ENV=

# Bcrypt
BCRYPT_SALT_ROUNDS=

# Criptografia de segredos em repouso (token da Evolution). NÃO troque depois de configurar o WhatsApp.
CRYPTO_KEY=

# E-mail (redefinição de senha) — Hostinger
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Fila do WhatsApp: deixe true em UM só servidor/instância da API
WHATSAPP_FILA_ATIVA=
